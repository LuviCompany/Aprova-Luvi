# Aprova Luvi — variáveis de ambiente. TODAS as que o código lê estão aqui.
# Copie para .env.local (desenvolvimento) ou cadastre no painel da Vercel. NUNCA commite valores reais.
# Confira o que está carregado, sem expor chaves:  npm run env:check
#
# Nenhuma variável tem prefixo NEXT_PUBLIC_ de propósito: o navegador não fala com o Supabase
# (tudo passa por Server Actions e rotas do servidor) e nada é congelado na build.

# --- Supabase (obrigatórias fora do modo demonstração) ---------------------------------------
# Painel do projeto > Project Settings > API Keys.
SUPABASE_URL=
# Chave publicável (formato sb_publishable_...). Respeita a RLS.
SUPABASE_PUBLISHABLE_KEY=

# --- SECRETA: somente servidor, nunca no navegador, nunca em log, nunca no chat ---------------
# Chave secreta (formato sb_secret_...). IGNORA a RLS. Usada em convites de usuário, no fluxo de
# aprovação por link e em URLs assinadas de arquivos (Módulos 3 e 4).
SUPABASE_SECRET_KEY=

# --- Endereço DESTE ambiente ------------------------------------------------------------------
# Usado nos links dos e-mails (recuperação de senha, convites).
#   desenvolvimento: http://localhost:3000   (qualquer endereço fora de localhost é IGNORADO em dev)
#   produção:        https://aprova.luvicompany.com.br   (obrigatório e https; sem isso o app não envia link)
APP_URL=http://localhost:3000

# --- Modo demonstração (Fase 1) --------------------------------------------------------------
# Login fictício e dados de exemplo. Só vale se o Supabase NÃO estiver configurado: preencher
# SUPABASE_URL + SUPABASE_PUBLISHABLE_KEY desliga a demonstração automaticamente.
# APROVA_DEMO_MODE=true

# --- Fase 3 (e-mails de notificação) — ainda NÃO lida pelo código ------------------------------
# RESEND_API_KEY=

# --- Nomes legados (ainda aceitos como reserva; evite) ----------------------------------------
# SUPABASE_ANON_KEY (chave anon, JWT)  -> use SUPABASE_PUBLISHABLE_KEY
# SUPABASE_SERVICE_ROLE_KEY            -> use SUPABASE_SECRET_KEY
# NEXT_PUBLIC_APP_URL                  -> use APP_URL
