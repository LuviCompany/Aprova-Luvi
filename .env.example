# Aprova Luvi — variáveis de ambiente.
# Copie para .env.local (desenvolvimento) ou cadastre no painel da Vercel. NUNCA commite valores reais.
# Nenhuma variável tem prefixo NEXT_PUBLIC_ de propósito: o navegador não fala com o Supabase.

# --- Supabase (obrigatórias fora do modo demonstração) ---------------------------------------
# Project Settings > API
SUPABASE_URL=
# Chave "anon" ou "publishable". É pública por natureza, mas fica só no servidor aqui.
SUPABASE_ANON_KEY=

# --- SECRETAS: somente servidor, nunca no navegador, nunca em log ----------------------------
# Chave "service_role" / "secret". Ignora a RLS. Usada em convites de usuário, no fluxo de
# aprovação por link e em URLs assinadas de arquivos.
SUPABASE_SERVICE_ROLE_KEY=

# --- App -------------------------------------------------------------------------------------
# URL pública (usada nos links dos e-mails de redefinição de senha).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Fase 3 (e-mails de notificação) ----------------------------------------------------------
# RESEND_API_KEY=

# --- Modo demonstração (Fase 1) --------------------------------------------------------------
# Login fictício e dados de exemplo. Só vale se o Supabase NÃO estiver configurado: preencher
# SUPABASE_URL/SUPABASE_ANON_KEY desliga a demonstração automaticamente.
# APROVA_DEMO_MODE=true
